          "_name": "custom-html",
          "_sourceTheme": "startm5",
          "_customHTML": "<section mbr-id=\"_anchor\" class=\"mbr-section article content1\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#386416\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-text col-12 col-md-12\">\n                <h2 class=\"mbr-fonts-style block-title align-center\" data-app-selector=\".block-title\" mbr-theme-style=\"display-2\">Spotify R&amp;B</h2>\n\t\t\t\t<a href=\"https://open.spotify.com/track/3UNUotLkNKohLNao1ba0Wq?si=a20e8a8ecc7d41b2\"><img class=\"my-image\" src=\"@PROJECT_PATH@/assets/images/img-1411.jpg-1179x1179.jpg\" alt></a>\n        <iframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/album/2EjWr3pR1qgy34JZQajA6p?utm_source=generator\" width=\"100%\" height=\"352\" frameborder=\"0\" allowfullscreen allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"></iframe><iframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/album/6NEIEJ1JMvKbDgrvTVX8Nb?utm_source=generator\" width=\"100%\" height=\"352\" frameborder=\"0\" allowfullscreen allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"></iframe><iframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/album/0rplzI9wecU21LqBhFVrXb?utm_source=generator\" width=\"100%\" height=\"352\" frameborder=\"0\" allowfullscreen allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"></iframe><iframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/album/5NxJxUeZBEpJD8bcOdfxMu?utm_source=generator\" width=\"100%\" height=\"352\" frameborder=\"0\" allowfullscreen allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"></iframe><iframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/track/2ymE7vuyn80U3anN0IVEyM?utm_source=generator\" width=\"100%\" height=\"352\" frameborder=\"0\" allowfullscreen allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"></iframe><iframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/album/5Nx4yX6hz46FXVi24TiNT5?utm_source=generator\" width=\"100%\" height=\"352\" frameborder=\"0\" allowfullscreen allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"></iframe><iframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/album/3ZUUb2pa1pWaVnHaR5Hksq?utm_source=generator\" width=\"100%\" height=\"352\" frameborder=\"0\" allowfullscreen allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"></iframe><iframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/track/6GOKITqQCp3pd8PRZiV5IW?utm_source=generator\" width=\"100%\" height=\"352\" frameborder=\"0\" allowfullscreen allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"></iframe><iframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/album/4xiMeiWQg4yxkmCEhbLNAl?utm_source=generator\" width=\"100%\" height=\"352\" frameborder=\"0\" allowfullscreen allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"></iframe></div></div></div></section><iframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/album/7LqVyhslptbw9JpPHR2v7s?utm_source=generator\" width=\"100%\" height=\"352\" frameborder=\"0\" allowfullscreen allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"></iframe><iframe style=\"border-radius:12px\" src=\"https://open.spotify.com/embed/album/2YwBrAs3rWhurdoI1zxLZP?utm_source=generator\" width=\"100%\" height=\"352\" frameborder=\"0\" allowfullscreen allow=\"autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture\" loading=\"lazy\"></iframe>",
