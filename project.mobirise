            ".mbr-section-title": {
              "text-align": "center",
              "color": "#ffaac7"
            },
            ".card-title1, .social-row": {
              "color": "#008063"
            },
            ".card-text2, .card2 .mbr-section-btn": {
              "color": "#ffffff"
